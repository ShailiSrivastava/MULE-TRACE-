# MuleTrace API - Backend Environment Variables
# Copy to backend/.env for local backend development

PROJECT_NAME="MuleTrace API"
ENVIRONMENT=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muletrace_dev

# SQLAlchemy Connection String
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/muletrace_dev
