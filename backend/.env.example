# MuleTrace API - Backend Environment Variables
# Copy to backend/.env for local backend development

PROJECT_NAME="MuleTrace API"
ENVIRONMENT=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Allowed CORS origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL connection settings
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muletrace_dev

# Optional SQLAlchemy URL override. Leave empty to build it from POSTGRES_* above.
DATABASE_URL=
DATABASE_ECHO=False

# Authentication configuration. Generate a unique secret for each environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=muletrace
JWT_AUDIENCE=muletrace-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CSV ingestion limits (10 MiB, 10,000 data rows)
CSV_MAX_UPLOAD_BYTES=10485760
CSV_MAX_ROWS=10000

# Redis credentials and localhost port for the Compose development service
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_DB=0
# Optional Redis URL override; leave blank to build it from REDIS_* settings.
CELERY_BROKER_URL=

# Background analysis limits (stale timeout must exceed task hard timeout)
ANALYSIS_MAX_ACTIVE_PER_DATASET=1
ANALYSIS_MAX_ACTIVE_PER_USER=3
ANALYSIS_MAX_RETRIES=3
ANALYSIS_TASK_SOFT_TIME_LIMIT=3300
ANALYSIS_TASK_TIME_LIMIT=3600
ANALYSIS_STALE_JOB_SECONDS=3900
ANALYSIS_BROKER_CONNECT_TIMEOUT=2
