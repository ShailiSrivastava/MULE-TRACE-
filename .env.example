# MuleTrace - Backend Environment Configuration Template
# Copy this file to the repository root .env or backend/.env for local backend development.
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL!

# =============================================================================
# Backend Configuration (FastAPI & Server)
# =============================================================================
PROJECT_NAME="MuleTrace API"
ENVIRONMENT=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
PROXY_HEADERS_ENABLED=False
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO

# CORS Origins (Comma-separated or JSON list for frontend connectivity)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost", "127.0.0.1", "testserver"]
MAX_REQUEST_BODY_BYTES=12582912
METRICS_ENABLED=False
METRICS_TOKEN=
# Production Docker deployments should use secret-file variables instead:
# METRICS_TOKEN_FILE=/.secrets/metrics_token

# =============================================================================
# Database Configuration (PostgreSQL & SQLAlchemy)
# =============================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muletrace_dev

# Optional SQLAlchemy URL override. Leave empty to build it from POSTGRES_* above.
DATABASE_URL=
# Optional Docker secret file paths (leave empty for local development).
# POSTGRES_PASSWORD_FILE=
# DATABASE_URL_FILE=
DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=5
# Optional: set to require TLS when PostgreSQL is externally managed.
DATABASE_SSLMODE=
SLOW_QUERY_THRESHOLD_MS=1000

# Authentication configuration. Generate a unique secret for each environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Production containers may use JWT_SECRET_KEY_FILE instead.
# JWT_SECRET_KEY_FILE=/.secrets/jwt_secret_key
JWT_ISSUER=muletrace
JWT_AUDIENCE=muletrace-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CSV ingestion limits (10 MiB, 10,000 data rows)
CSV_MAX_UPLOAD_BYTES=10485760
CSV_MAX_ROWS=10000

# Redis credentials and localhost port for the Compose development service
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
# Optional Redis URL override; leave blank to build it from REDIS_* settings.
CELERY_BROKER_URL=
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CSV_UPLOAD_RATE_LIMIT_REQUESTS=10
CSV_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

# Background analysis limits (stale timeout must exceed task hard timeout)
ANALYSIS_MAX_ACTIVE_PER_DATASET=1
ANALYSIS_MAX_ACTIVE_PER_USER=3
ANALYSIS_MAX_RETRIES=3
ANALYSIS_TASK_SOFT_TIME_LIMIT=3300
ANALYSIS_TASK_TIME_LIMIT=3600
ANALYSIS_STALE_JOB_SECONDS=3900
ANALYSIS_BROKER_CONNECT_TIMEOUT=2
