# MuleTrace - Unified Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT:
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL!

# =============================================================================
# Backend Configuration (FastAPI & Server)
# =============================================================================
PROJECT_NAME="MuleTrace API"
ENVIRONMENT=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# CORS Origins (Comma-separated or JSON list for frontend connectivity)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# =============================================================================
# Database Configuration (PostgreSQL & SQLAlchemy)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muletrace_dev

# SQLAlchemy Database URL
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/muletrace_dev

# =============================================================================
# Frontend Configuration (Vite & React)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000
