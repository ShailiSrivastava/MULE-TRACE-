# Copy to the ignored .env.production file and replace every placeholder.
# Keep actual secret files outside version control with owner-only access.
ENVIRONMENT=production
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000
HEALTHCHECK_HOST=api.muletrace.example
LOG_LEVEL=INFO
PROXY_HEADERS_ENABLED=False
FORWARDED_ALLOW_IPS=127.0.0.1

# Replace these example public names before deployment.
TRUSTED_HOSTS=["api.muletrace.example"]
CORS_ORIGINS=["https://muletrace.example"]

# Use a unique immutable release tag for each MuleTrace build.
MULETRACE_IMAGE_TAG=release-2026.11.24
MULETRACE_API_BIND_ADDRESS=127.0.0.1
MULETRACE_API_PORT=8000

POSTGRES_DB=muletrace_prod
POSTGRES_USER=muletrace_prod
POSTGRES_PASSWORD_FILE=./.secrets/postgres_password
REDIS_PASSWORD_FILE=./.secrets/redis_password
JWT_SECRET_KEY_FILE=./.secrets/jwt_secret_key
METRICS_TOKEN_FILE=./.secrets/metrics_token
METRICS_ENABLED=True

# TLS is optional only for the isolated private Compose network. Set require
# (or verify-full with CA configuration) for externally managed PostgreSQL.
DATABASE_SSLMODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=5
SLOW_QUERY_THRESHOLD_MS=1000
MAX_REQUEST_BODY_BYTES=12582912
CSV_MAX_UPLOAD_BYTES=10485760
CSV_MAX_ROWS=10000
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CSV_UPLOAD_RATE_LIMIT_REQUESTS=10
CSV_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
ANALYSIS_MAX_ACTIVE_PER_DATASET=1
ANALYSIS_MAX_ACTIVE_PER_USER=3
ANALYSIS_MAX_RETRIES=3
ANALYSIS_TASK_SOFT_TIME_LIMIT=3300
ANALYSIS_TASK_TIME_LIMIT=3600
ANALYSIS_STALE_JOB_SECONDS=3900
ANALYSIS_BROKER_CONNECT_TIMEOUT=2
